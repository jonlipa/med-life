*.sqlite
*.sqlite3
*.db
*.bak
*.dump
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
/certs/

# Dependencies and tooling
/vendor/
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
